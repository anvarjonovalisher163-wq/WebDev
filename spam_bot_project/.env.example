# Telegram
BOT_TOKEN=123456:ABC-DEF_your_bot_token_here
ADMIN_TELEGRAM_IDS=123456789,987654321

# Database
POSTGRES_DB=spam_bot
POSTGRES_USER=spam_bot
POSTGRES_PASSWORD=change_me
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Har bir guruhning Gemini API kalitini shifrlash uchun Fernet kaliti.
# Yaratish: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
KEY_ENCRYPTION_SECRET=

# Botning ommaviy HTTPS manzili (/setkey havolasini yaratish uchun)
BASE_URL=https://your-domain.example
WEB_HOST=0.0.0.0
WEB_PORT=8080

GEMINI_MODEL=gemini-2.5-flash
GEMINI_PRICE_IN=0.30
GEMINI_PRICE_OUT=2.50

MAX_GROUPS_PER_OWNER=20
REPORT_HOUR=9
RETENTION_DAYS=90

LOG_LEVEL=INFO
TZ=Asia/Tashkent
