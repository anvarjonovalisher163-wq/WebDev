# Telegram
BOT_TOKEN=123456:ABC-DEF_your_bot_token_here
SUPER_ADMIN_IDS=123456789,987654321

# Database
POSTGRES_DB=referral_bot
POSTGRES_USER=referral_bot
POSTGRES_PASSWORD=change_me
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# "redis" (production) yoki "memory" (Redis o'rnatilmagan lokal test uchun)
STORAGE_BACKEND=redis

# App
LOG_LEVEL=INFO
TZ=Asia/Tashkent

# Reyting Mini App (ixtiyoriy). Domen va SSL tayyor bo'lgach to'ldiring -
# https://<domen> ko'rinishida. Bo'sh qoldirilsa, "🏆 Reyting" tugmasi
# Mini App o'rniga oddiy matnli reytingni ko'rsatadi.
WEBAPP_URL=

# Email orqali kirish (ixtiyoriy) - SMTP orqali kirish kodi yuboriladi.
# Masalan Gmail uchun: smtp.gmail.com, port 587, SMTP_USER - emailingiz,
# SMTP_PASSWORD - Gmail "ilova paroli" (oddiy parol emas).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Google orqali kirish (ixtiyoriy) - Google Cloud Console'da OAuth 2.0
# ilovasi yaratib, Client ID/Secret'ni shu yerga qo'ying. Ruxsat berilgan
# redirect URI: https://<domen>/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Telefon raqam orqali kirish (ixtiyoriy) - Eskiz.uz SMS xizmati orqali.
# https://notify.eskiz.uz da ro'yxatdan o'ting.
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
